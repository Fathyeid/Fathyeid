تربوية وقصص قبل النوم (مع تمييز الخيالي من الموثّق)","subs":["قصص تربوية","قصص قبل النوم","قصص علمية"],"count":0},{"id":"people","n":"الشخصيات والأعلام","ic":"🧑‍🔬","color":"#457b9d","desc":"علماء ومخترعون ومستكشفون وإنجازاتهم","subs":["العلماء المسلمون","المخترعون","المستكشفون"],"count":0},{"id":"occasions","n":"المناسبات الإسلامية","ic":"🌙","color":"#c9a227","desc":"رمضان والعيدان والحج والأيام الفاضلة","subs":[],"count":0},{"id":"puzzles","n":"الألغاز والذكاء","ic":"🧩","color":"#ef476f","desc":"ألغاز وتحديات تفكير وألعاب ذاكرة","subs":[],"count":0},{"id":"skills","n":"المهارات والحياة","ic":"🎯","color":"#06a77d","desc":"إدارة الوقت والسلامة والتفكير وحل المشكلات","subs":[],"count":0}],"items":[{"id":"an-nuh","c":"anbiya","t":"نوح عليه السلام والسفينة","k":"موثق","age":[5,12],"l":1,"ic":"⛵","sub":"","tags":["نوح","السفينة","الطوفان","الصبر"],"m":["آيات","اختبار","نص"],"x":"نوح عليه السلام من أولي العزم من الرسل، أرسله الله إلى قومه يدعوهم إلى عبادة الله وحده، وصبر عليهم صبراً طويلاً جداً."},{"id":"an-ibrahim","c":"anbiya","t":"إبراهيم عليه السلام والنار","k":"موثق","age":[5,12],"l":1,"ic":"🔥","sub":"","tags":["إبراهيم","الأصنام","النار","الكعبة","التوحيد"],"m":["آيات","اختبار","نص"],"x":"إبراهيم عليه السلام خليل الرحمن، كان قومه يعبدون الأصنام، فدعاهم إلى عبادة الله وحده، فأنجاه الله من النار."},{"id":"an-yusuf","c":"anbiya","t":"يوسف عليه السلام: من البئر إلى خزائن مصر","k":"موثق","age":[7,14],"l":2,"ic":"🌾","sub":"","tags":["يوسف","يعقوب","الصبر","العفو","مصر"],"m":["آيات","اختبار","نص"],"x":"قصة يوسف عليه السلام سمّاها الله «أحسن القصص»، وفيها الصبر والعفو وحسن الظن بالله."},{"id":"an-musa","c":"anbiya","t":"موسى عليه السلام وفرعون","k":"موثق","age":[6,14],"l":2,"ic":"🌊","sub":"","tags":["موسى","فرعون","هارون","البحر","العصا"],"m":["آيات","اختبار","نص"],"x":"موسى عليه السلام كليم الله، حفظه الله وهو رضيع، وأرسله إلى فرعون الظالم، ونجّاه وقومه بشقّ البحر."},{"id":"an-yunus","c":"anbiya","t":"يونس عليه السلام في بطن الحوت","k":"موثق","age":[4,12],"l":1,"ic":"🐋","sub":"","tags":["يونس","الحوت","الدعاء","ذو النون"],"m":["آيات","اختبار","نص"],"x":"يونس عليه السلام نبي كريم، دعا الله وهو في بطن الحوت فنجّاه الله، وعلّمنا أن الدعاء والتسبيح ينجّيان من الكرب."},{"id":"an-sulayman","c":"anbiya","t":"سليمان عليه السلام والنملة والهدهد","k":"موثق","age":[4,12],"l":1,"ic":"🐜","sub":"","tags":["سليمان","النملة","الهدهد","سبأ","الشكر"],"m":["آيات","اختبار","نص"],"x":"آتى الله سليمان عليه السلام ملكاً عظيماً، وعلّمه منطق الطير، وسخّر له الجنود من الجن والإنس والطير، فكان عبداً شاكراً."},{"id":"an-isa","c":"anbiya","t":"عيسى عليه السلام يتكلم في المهد","k":"موثق","age":[6,14],"l":2,"ic":"🌴","sub":"","tags":["عيسى","مريم","المهد","الإنجيل"],"m":["آيات","اختبار","نص"],"x":"عيسى ابن مريم عليه السلام من أولي العزم من الرسل، وُلد بمعجزة من غير أب، وتكلّم وهو طفل في المهد."},{"id":"ib-arkan-islam","c":"ibadat","t":"أركان الإسلام الخمسة","k":"موثق","age":[4,10],"l":1,"ic":"🕋","sub":"أركان الإسلام","tags":["الإسلام","الأركان","الصلاة","الزكاة","الصوم","الحج"],"m":["اختبار","بطاقات","خطوات","نص"],"x":"الإسلام مثل بيت جميل يقوم على خمسة أعمدة، علّمنا إياها النبي ﷺ."},{"id":"ib-arkan-iman","c":"ibadat","t":"أركان الإيمان الستة","k":"موثق","age":[6,12],"l":1,"ic":"💚","sub":"أركان الإيمان","tags":["الإيمان","الملائكة","الكتب","الرسل","القدر"],"m":["آيات","اختبار","خطوات","نص"],"x":"الإيمان ما يستقر في القلب ويصدّقه العمل، وأركانه ستة كما في حديث جبريل عليه السلام."},{"id":"ib-wudu","c":"ibadat","t":"تعلّم الوضوء خطوة بخطوة","k":"موثق","age":[5,12],"l":1,"ic":"💧","sub":"الطهارة والصلاة","tags":["الوضوء","الطهارة","الصلاة"],"m":["آيات","اختبار","خطوات","نص"],"x":"الوضوء طهارة نستعد بها للصلاة، وقد علّمنا الصحابي عثمان بن عفان رضي الله عنه كيف كان النبي ﷺ يتوضأ."},{"id":"ib-salah","c":"ibadat","t":"كيف أصلي؟","k":"موثق","age":[6,12],"l":2,"ic":"🧎","sub":"الطهارة والصلاة","tags":["الصلاة","الركوع","السجود"],"m":["اختبار","خطوات","نص"],"x":"الصلاة صلة بيننا وبين الله، وقال النبي ﷺ: «صلّوا كما رأيتموني أصلي»."},{"id":"ib-sawm","c":"ibadat","t":"الصيام في رمضان","k":"موثق","age":[6,12],"l":1,"ic":"🌙","sub":"الصيام والزكاة والحج","tags":["الصيام","رمضان","السحور"],"m":["آيات","اختبار","خطوات","نص"],"x":"الصيام عبادة عظيمة فرضها الله في شهر رمضان، نتعلّم فيها الصبر ونشعر بالفقراء."},{"id":"ib-asma","c":"ibadat","t":"من أسماء الله الحسنى","k":"موثق","age":[5,12],"l":1,"ic":"✨","sub":"أركان الإيمان","tags":["أسماء الله الحسنى","الإيمان بالله"],"m":["آيات","اختبار","بطاقات","خطوات","نص"],"x":"لله تسعة وتسعون اسماً حسنى، ومن عرفها وعمل بمعانيها أحبّه الله. لنتعرّف على بعضها."},{"id":"ib-adhkar","c":"ibadat","t":"أذكار يومي الصغيرة","k":"موثق","age":[4,12],"l":1,"ic":"🤲","sub":"الأذكار","tags":["الأذكار","الأدعية","النوم","الطعام"],"m":["اختبار","بطاقات","خطوات","نص"],"x":"أذكار قصيرة نقولها في يومنا فتحفظنا ويرضى الله عنا."},{"id":"ak-sidq","c":"akhlaq","t":"الصدق طريق الجنة","k":"موثق","age":[4,12],"l":1,"ic":"🌟","sub":"الأخلاق","tags":["الصدق","الأخلاق"],"m":["آيات","اختبار","نص"],"x":"الصدق أن نقول الحقيقة دائماً، حتى لو كانت صعبة. والصادق يحبه الله ويثق به الناس."},{"id":"ak-rahma","c":"akhlaq","t":"الرحمة بالحيوان","k":"موثق","age":[4,12],"l":1,"ic":"🐕","sub":"الأخلاق","tags":["الرحمة","الحيوان","الأخلاق"],"m":["اختبار","نص"],"x":"الرحمة خلق عظيم يشمل الناس والحيوانات. وقد حكى لنا النبي ﷺ قصة رجل غفر الله له لأنه سقى كلباً عطشان."},{"id":"ak-walidayn","c":"akhlaq","t":"برّ الوالدين","k":"موثق","age":[4,12],"l":1,"ic":"👨‍👩‍👧","sub":"الأخلاق","tags":["الوالدين","البر","الأخلاق"],"m":["آيات","اختبار","نص"],"x":"أمرنا الله بالإحسان إلى الوالدين، وجعل برّهما من أحب الأعمال إليه."},{"id":"ak-nadhafa","c":"akhlaq","t":"النظافة من الإيمان","k":"موثق","age":[3,10],"l":1,"ic":"🧼","sub":"الآداب","tags":["النظافة","الطهارة","الآداب"],"m":["اختبار","خطوات","نص"],"x":"المسلم نظيف في جسمه وثيابه ومكانه، وقد علّمنا النبي ﷺ أن الطهور نصف الإيمان."},{"id":"ak-taam","c":"akhlaq","t":"آداب الطعام","k":"موثق","age":[3,10],"l":1,"ic":"🍽️","sub":"الآداب","tags":["آداب الطعام","الآداب"],"m":["اختبار","خطوات","نص"],"x":"علّم النبي ﷺ غلاماً صغيراً كيف يأكل، فقال له: «يا غلام، سمّ الله، وكُل بيمينك، وكُل مما يليك»."},{"id":"ak-salam","c":"akhlaq","t":"أفشوا السلام","k":"موثق","age":[4,12],"l":1,"ic":"👋","sub":"الآداب","tags":["السلام","التحية","الآداب"],"m":["آيات","اختبار","خطوات","نص"],"x":"السلام تحية المسلمين، وهو سبب للمحبة بين الناس كما أخبر النبي ﷺ."},{"id":"ak-amana","c":"akhlaq","t":"الأمانة","k":"موثق","age":[6,12],"l":1,"ic":"🔐","sub":"الأخلاق","tags":["الأمانة","الأخلاق"],"m":["آيات","اختبار","نص"],"x":"الأمانة أن نحفظ ما يُعطى لنا، ونرد الأشياء لأصحابها، ونحفظ السر. وكان النبي ﷺ يُلقَّب قبل البعثة بالصادق الأمين."}]}